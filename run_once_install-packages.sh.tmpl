{{ if eq .chezmoi.osRelease.id "ubuntu" -}}
#!/bin/sh

sudo apt update
sudo apt install neovim jq vim git zsh htop cmatrix tmux wget cowsay lolcat fortune-mod ripgrep

[[ ! $(basename $SHELL) = 'zsh' ]] && chsh -s $(which zsh)
if [ ! -f ~/.ssh/id_ed25519 ]; then
  echo 'Hostname for ssh key eg. test@work.com'
  read hostname
  ssh-keygen -o -a 100 -t ed25519 -f ~/.ssh/id_ed25519 -C "$hostname"
  echo 'ssh Key generated: copy this to github'
  echo $(cat ~/.ssh/id_ed25519.pub)
fi
{{ end -}}


{{ if (or (eq .chezmoi.osRelease.id "endeavouros") (eq .chezmoi.osRelease.id "arch")) -}}
#!/bin/sh

sudo pacman -Syy
# base-devel is needed for installing yay
sudo pacman -S base-devel --needed --noconfirm

if ! [[ -x "$(command -v yay)" ]]
then
  cd ~
  sudo pacman -Sy git --noconfirm
  git clone https://aur.archlinux.org/yay.git
  cd yay
  makepkg -si
  cd ..
  rm -rf yay
fi

PACKAGES=(
  # terminal emulators
  alacritty
  ghostty
  kitty

  # utils
  autofs
  chafa
  chezmoi
  ethtool
  eza
  fzf
  htop
  jq
  mpv
  net-tools
  nodejs
  npm
  ookla-speedtest-bin
  pfetch
  powerline
  powerline-fonts-git
  ripgrep
  unzip
  wget

  # music
  audacious

  # programming
  docker
  git
  go
  less
  neovim
  nvm
  perl
  python
  ruby
  ruby
  rustup
  tmux
  vim
  
  # zsh
  zsh
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-theme-powerlevel10k-git
  zsh-vi-mode

  # fun?
  cmatrix
  cowsay
  fortune-mod
  lolcat
)

DESKTOP_PACKAGES=(
  # utils
  dualsensectl
  pavucontrol
  playerctl
  polkit
  polkit-kde-agent
  
  # apps
  firefox
  plex-desktop
  
  # audio
  pipewire
  wireplumber
  
  # hyprland
  dunst
  grim
  hyprcursor
  hyprland
  hyprpaper
  hyprpicker
  sddm
  waybar
  xdg-desktop-portal-hyprland
)

yay -S "${PACKAGES[@]}" --needed --noconfirm
{{- if eq .desktop 1 }}
yay -S "${DESKTOP_PACKAGES[@]}" --needed --noconfirm
{{- end }}

[[ ! $(basename $SHELL) = 'zsh' ]] && chsh -s $(which zsh)

. ~/.nvm/nvm.sh
nvm install stable
nvm use system

printf 'Is this a QEMU VM unraid etc (y/n)? '
read qemu

if [ "$qemu" != "${qemu#[Yy]}" ]; then
	yay -S qemu-guest-agent --needed --noconfirm
fi

if [ ! -f ~/.ssh/id_ed25519 ]; then
  echo 'Hostname for ssh key eg. test@work.com'
  read hostname
  ssh-keygen -o -a 100 -t ed25519 -f ~/.ssh/id_ed25519 -C "$hostname"
  echo 'ssh Key generated: copy this to github'
  echo $(cat ~/.ssh/id_ed25519.pub)
fi
{{ end -}}


